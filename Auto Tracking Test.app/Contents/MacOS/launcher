#!/bin/bash
# Auto Tracking Test — launcher: mở dashboard đang chạy, hoặc tự chạy server nếu chưa có,
# rồi mở trình duyệt. adb + openpyxl đã đóng gói sẵn trong Resources/vendor — không cần cài.
# Chỉ ffmpeg (tính năng Trim video, không bắt buộc) là còn phải tự `brew install ffmpeg`,
# xem README.md mục 0.
set -u

# .app này phải nằm ngay trong thư mục tool (cạnh server.py) — đi lên 3 cấp từ
# Contents/MacOS/launcher là ra thư mục đó.
CONTENTS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
APP_DIR="$(cd "$CONTENTS_DIR/../.." && pwd)"
VENDOR="$CONTENTS_DIR/Resources/vendor"
SERVER="$APP_DIR/server.py"
PORT=8765
LOG="/tmp/auto-tracking-test.log"

# Vendor trước (adb đóng gói sẵn), rồi Homebrew (ffmpeg, hoặc adb bản mới hơn nếu máy tự cài) —
# Homebrew không nằm trong PATH mặc định khi app mở từ Finder (double-click) nên phải thêm tay.
export PATH="$VENDOR/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
# openpyxl đóng gói sẵn — python3 hệ thống (có sẵn trên mọi Mac) tìm thấy mà không cần pip install.
export PYTHONPATH="$VENDOR/python${PYTHONPATH:+:$PYTHONPATH}"

notify() {
  /usr/bin/osascript -e "display dialog \"$1\" buttons {\"OK\"} with title \"Auto Tracking Test\" with icon caution" >/dev/null 2>&1
}

if [ ! -f "$SERVER" ]; then
  notify "Không tìm thấy server.py cạnh app này (đang tìm ở: $APP_DIR).\n\nApp này phải nằm ngay trong thư mục tool đã git clone (cùng chỗ với server.py, README.md...) — đừng copy app ra ngoài một mình."
  exit 1
fi

if ! command -v python3 >/dev/null 2>&1; then
  notify "Không tìm thấy Python 3 trên máy này — bình thường mọi Mac đều có sẵn.\n\nThử mở Terminal, gõ 'xcode-select --install' rồi mở lại app."
  exit 1
fi

if ! /usr/sbin/lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then
  cd "$APP_DIR" || exit 1
  nohup python3 server.py >"$LOG" 2>&1 &
  disown
  # Chờ server thật sự lên (bind port) trước khi mở trình duyệt, tối đa ~6s.
  for _ in $(seq 1 20); do
    /usr/sbin/lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1 && break
    sleep 0.3
  done
  if ! /usr/sbin/lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then
    notify "Server không khởi động được. Xem log: $LOG"
    exit 1
  fi
fi

open "http://127.0.0.1:$PORT/"
